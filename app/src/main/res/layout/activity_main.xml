<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#121212">

        <!-- ✅ TOP BAR (ONLY HEADER) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0D47A1"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="16dp"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HydroIQ"
                android:textColor="@android:color/white"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- ✅ HOME CONTENT (SCROLLABLE) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- IMAGE -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/homescreen"
                    android:layout_marginBottom="12dp"/>

                <!-- WELCOME -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to HydroIQ"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <!-- SUBTITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time water monitoring system"
                    android:textColor="#B0B0B0"
                    android:paddingBottom="12dp"/>

                <!-- CONTENT -->
                <TextView
                    android:id="@+id/contentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E0E0E0"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:text="HydroIQ helps you monitor water quality using IoT sensors like pH, TDS, turbidity, and temperature. It provides real-time insights, alerts, and historical data to ensure safe and efficient water usage."/>

                <!-- LEARN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Learn and Awareness"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:paddingTop="16dp"/>

                <!-- LINKS -->
                <TextView
                    android:id="@+id/linkWHO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Water Safety and Pollution (WHO)"
                    android:textColor="#4FC3F7"
                    android:padding="10dp"/>

                <TextView
                    android:id="@+id/linkUNESCO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Water Conservation (UNESCO)"
                    android:textColor="#4FC3F7"
                    android:padding="10dp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>