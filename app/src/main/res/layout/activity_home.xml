<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".ui.theme.activities.HomeActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Welcome -->
            <ImageView
                android:id="@+id/homeImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/homescreen"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to HydroIQ 👋"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time water monitoring system"
                android:textColor="#B0B0B0"
                android:paddingBottom="12dp"/>

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HydroIQ – Smart Water Monitoring"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:paddingBottom="8dp"/>

            <!-- Content -->
            <TextView
                android:id="@+id/contentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:textColor="#E0E0E0"/>

            <!-- Learn Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn and Explore 🌍"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"/>

            <!-- WHO CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWHO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#1E1E1E">

                <LinearLayout
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- WHO -->
                    <TextView
                        android:id="@+id/linkWHO"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌍 WHO - Drinking Water\nLearn about global water safety and pollution"
                        android:textSize="15sp"
                        android:textColor="#4FC3F7"
                        android:padding="12dp"
                        android:background="#1E1E1E"
                        android:layout_marginBottom="8dp"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UNESCO CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUNESCO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#1E1E1E">

                <LinearLayout
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/linkUNESCO"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💧 UNESCO - Water Security\nExplore water conservation strategies"
                        android:textSize="15sp"
                        android:textColor="#4FC3F7"
                        android:padding="12dp"
                        android:background="#1E1E1E"
                        android:layout_marginBottom="8dp"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UNEP CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUNEP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#1E1E1E">

                <LinearLayout
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/linkUNEP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌱 UNEP - Water Pollution\nUnderstand environmental challenges"
                        android:textSize="15sp"
                        android:textColor="#4FC3F7"
                        android:padding="12dp"
                        android:background="#1E1E1E"
                        android:layout_marginBottom="8dp"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WaterAid CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWaterAid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#1E1E1E">

                <LinearLayout
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/linkWaterAid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚰 WaterAid\nClean water and sanitation awareness"
                        android:textSize="15sp"
                        android:textColor="#4FC3F7"
                        android:padding="12dp"
                        android:background="#1E1E1E"
                        android:layout_marginBottom="8dp"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>