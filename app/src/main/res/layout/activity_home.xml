<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A8E6CF"
    tools:context=".ui.theme.activities.HomeActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TOP IMAGE -->
            <ImageView
                android:id="@+id/homeImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/homescreen"
                android:layout_marginBottom="16dp"
                android:background="#7CCBA2"/>

            <!-- WELCOME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to HydroIQ 👋"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1F4E79"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time water monitoring system"
                android:textColor="#2F4F4F"
                android:paddingBottom="12dp"/>

            <!-- TITLE -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Water Monitoring"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1F4E79"
                android:paddingBottom="8dp"/>

            <!-- CONTENT -->
            <TextView
                android:id="@+id/contentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:textColor="#1A2E2E"/>

            <!-- SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn and Explore 🌍"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1F4E79"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"/>

            <!-- CARD STYLE -->
            <!-- WHO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWHO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:backgroundTint="#7CCBA2">

                <TextView
                    android:id="@+id/linkWHO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌍 WHO - Drinking Water\nLearn about global water safety and pollution"
                    android:textSize="15sp"
                    android:textColor="#1F4E79"
                    android:padding="16dp"
                    android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- UNESCO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUNESCO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:backgroundTint="#7CCBA2">

                <TextView
                    android:id="@+id/linkUNESCO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💧 UNESCO - Water Security\nExplore water conservation strategies"
                    android:textSize="15sp"
                    android:textColor="#1F4E79"
                    android:padding="16dp"
                    android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- UNEP -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUNEP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:backgroundTint="#7CCBA2">

                <TextView
                    android:id="@+id/linkUNEP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌱 UNEP - Water Pollution\nUnderstand environmental challenges"
                    android:textSize="15sp"
                    android:textColor="#1F4E79"
                    android:padding="16dp"
                    android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- WaterAid -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWaterAid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:backgroundTint="#7CCBA2">

                <TextView
                    android:id="@+id/linkWaterAid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚰 WaterAid\nClean water and sanitation awareness"
                    android:textSize="15sp"
                    android:textColor="#1F4E79"
                    android:padding="16dp"
                    android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>