<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- IMAGE -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/homescreen"
            android:layout_marginBottom="16dp"
            android:background="@color/card_bg"/>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HydroIQ – Smart Water Monitoring"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="12dp"/>

        <!-- CONTENT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HydroIQ is an intelligent IoT-based water quality monitoring system designed to provide real-time insights into water conditions. By integrating advanced sensors such as pH, turbidity, TDS, and temperature, the system continuously tracks water quality parameters and delivers accurate data directly to your mobile application."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Water is one of the most essential resources for life, yet it is increasingly threatened by pollution and misuse. HydroIQ helps bridge the gap between awareness and action by offering a user-friendly platform with live analytics, alerts, and historical tracking."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The application promotes sustainability by analyzing water usage patterns and detecting anomalies. It helps reduce wastage and supports efficient water management across households, industries, and agriculture."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn More 🌍"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/primary"
            android:paddingBottom="10dp"/>

        <!-- WHO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="@color/card_bg"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/linkWHO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌍 WHO - Drinking Water Safety"
                android:textColor="@color/primary"
                android:padding="16dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- UNESCO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="@color/card_bg"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/linkUNESCO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💧 UNESCO - Water Conservation"
                android:textColor="@color/primary"
                android:padding="16dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- UNEP -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="@color/card_bg"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/linkUNEP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌱 UNEP - Water Pollution"
                android:textColor="@color/primary"
                android:padding="16dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- WATERAID -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="@color/card_bg"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/linkWaterAid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚰 WaterAid - Clean Water Awareness"
                android:textColor="@color/primary"
                android:padding="16dp"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>