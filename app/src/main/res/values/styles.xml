<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="boxStrokeColor">@color/cyan_accent</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">4dp</item>
        <item name="hintTextColor">@color/cyan_accent</item>
    </style>

    <style name="CustomEditText">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CustomButton">
        <item name="android:backgroundTint">@color/btn_blue</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:elevation">8dp</item>
    </style>
</resources>